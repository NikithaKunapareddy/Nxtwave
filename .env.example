# ==============================================================================
# PROJECT COMPASS: ENVIRONMENT CONFIGURATION
# NxtWave Growth Intern Challenge | 48-Hour Build | ₹0 Development Cost
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Database Configuration
# Option 1: SQLite (Default local zero-cost execution, zero setup)
DATABASE_URL=sqlite:///./local_compass.db

# Option 2: Supabase Cloud Database (REST + Realtime)
USE_SUPABASE=True
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-or-anon-key
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
# ------------------------------------------------------------------------------

# Admin Security Token (used to access /admin metrics and data reset)
ADMIN_TOKEN=compass_growth_admin_secret_2026

# Workshop Registration Destination
# Leave empty to use local simulated demo registration mode (Mode B)
# Set to official NxtWave workshop link for live campaign mode (Mode A):
# WORKSHOP_REGISTRATION_URL=https://nxtwave.in/workshops/build-ai-project-60-mins
WORKSHOP_REGISTRATION_URL=

# Optional AI Integration (Zero cost default is rules engine fallback)
ENABLE_OPTIONAL_LLM=True
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# ==============================================================================
# META WHATSAPP CLOUD API CONFIGURATION
# Mode: local_simulation | test | production
# ==============================================================================
WHATSAPP_MODE=test
WHATSAPP_DRY_RUN=False
WHATSAPP_VERIFY_TOKEN=compass_whatsapp_webhook_token_2026
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ALLOWED_RECIPIENTS=
META_APP_SECRET=

# Public base URL (for webhook callbacks)
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Frontend URL (e.g. deployed Vercel URL for share links)
FRONTEND_URL=

# Allowed CORS Origins (comma-separated, leave empty to allow all origins)
CORS_ORIGINS=
